{
  "name": "moneypath-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ensure-wasm": "node scripts/ensure-wasm.mjs",
    "predev": "npm run ensure-wasm",
    "dev": "vite",
    "prebuild": "npm run ensure-wasm",
    "build": "tsc --noEmit && tsc --noEmit -p e2e && vite build",
    "preview": "vite preview",
    "pretest": "npm run ensure-wasm",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "preact": "^10.27.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
