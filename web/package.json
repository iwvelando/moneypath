{
  "name": "moneypath-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ensure-wasm": "node scripts/ensure-wasm.mjs",
    "predev": "npm run ensure-wasm",
    "dev": "vite",
    "prebuild": "npm run ensure-wasm",
    "build": "tsc --noEmit && tsc --noEmit -p e2e && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --mode lan",
    "pretest": "npm run ensure-wasm",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "preact": "^11.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
